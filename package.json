{
  "name": "alttpr-po-launcher",
  "version": "2.4.0",
  "description": "ALTTPR PO Launcher - Launcher, Tracker & Music Pack Manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:helper": "node scripts/build-helper.js",
    "build": "node scripts/build-helper.js && electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.alttpr.po-launcher",
    "productName": "ALTTPR PO Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "launcher-preload.js",
      "renderer.html",
      "renderer.js",
      "styles.css",
      "icon.ico",
      "icon.png",
      "native/WinHelper.cs",
      "tracker/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "ALTTPR-PO-Launcher.exe"
    },
    "extraResources": [
      {
        "from": "native/bin",
        "to": ".",
        "filter": [
          "WinHelper.exe"
        ]
      }
    ],
    "publish": null
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "author": "Pennderin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Penderrin-Projects/alttpr-po-launcher.git"
  }
}
